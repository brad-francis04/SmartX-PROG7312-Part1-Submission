@page "/mesh-routing"
@using System.Net.Http.Json
@using SmartX.Shared
@inject HttpClient Http

<PageTitle>Smart-X Mesh Routing</PageTitle>

<div class="container-fluid p-4">

    <h1>🕸️ Smart-X Network Topology</h1>
    <p>Final POE – Network Routing and Historical Telemetry</p>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="alert alert-info">@message</div>
    }

   <button class="btn btn-primary mb-3" @onclick="RefreshAsync">
    Refresh Network
</button>

<hr />

<h3>🌐 Visual Network Topology</h3>
<p>Live representation of registered sensors and their wireless connections.</p>

@if (nodes.Count == 0)
{
    <p>No sensors available to display.</p>
}
else
{
    <div class="card p-3 mb-4">
        <svg viewBox="0 0 700 420"
             style="width:100%; max-width:900px; height:auto;">

            @* Draw wireless connections first *@
            @foreach (var connection in connections.Where(c => c.IsActive))
            {
                <line x1="@GetNodeX(connection.SourceSensorId)"
                      y1="@GetNodeY(connection.SourceSensorId)"
                      x2="@GetNodeX(connection.DestinationSensorId)"
                      y2="@GetNodeY(connection.DestinationSensorId)"
                      stroke="#777"
                      stroke-width="3" />

               
            }

            @* Draw sensor nodes *@
            @foreach (var node in nodes)
            {
                <circle cx="@GetNodeX(node.SensorId)"
                        cy="@GetNodeY(node.SensorId)"
                        r="32"
                        fill="@(node.IsGateway ? "#198754" : "#0d6efd")"
                        stroke="#ffffff"
                        stroke-width="3" />

                    <foreignObject x="@(GetNodeX(node.SensorId) - 40)"
                                   y="@(GetNodeY(node.SensorId) - 15)"
                                   width="80" height="30">
                        <div xmlns="http://www.w3.org/1999/xhtml"
                             style="text-align:center; color:white; font-size:11px;">
                            @(node.IsGateway ? "GW" : "NODE")
                        </div>
                    </foreignObject>

                    <foreignObject x="@(GetNodeX(node.SensorId) - 60)"
                                   y="@(GetNodeY(node.SensorId) + 40)"
                                   width="120" height="25">
                        <div xmlns="http://www.w3.org/1999/xhtml"
                             style="text-align:center; color:black; font-size:13px;">
                            @node.DeviceName
                        </div>
                    </foreignObject>

                    <foreignObject x="@(GetNodeX(node.SensorId) - 40)"
                                   y="@(GetNodeY(node.SensorId) + 55)"
                                   width="80" height="25">
                        <div xmlns="http://www.w3.org/1999/xhtml"
                             style="text-align:center; color:black; font-size:11px;">
                            @node.Status
                        </div>
                    </foreignObject>
            }
        </svg>

        <div class="mt-2">
            <span style="color:#198754;">●</span> Central Gateway
            &nbsp;&nbsp;
            <span style="color:#0d6efd;">●</span> Network Sensor
            &nbsp;&nbsp;
            <span style="color:#777;">━</span> Wireless Connection
        </div>
    </div>
}

    <h3>📡 Registered Network Sensors</h3>

    @if (nodes.Count == 0)
    {
        <p>No network sensors registered yet.</p>
    }
    else
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Sensor ID</th>
                    <th>Device</th>
                    <th>Status</th>
                    <th>Battery</th>
                    <th>Gateway</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var node in nodes)
                {
                    <tr>
                        <td>@node.SensorId</td>
                        <td>@node.DeviceName</td>
                        <td>@node.Status</td>
                        <td>@node.BatteryLevel%</td>
                        <td>@(node.IsGateway ? "Yes" : "No")</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <hr />

    <h3>🔗 Wireless Connections</h3>

    @if (connections.Count == 0)
    {
        <p>No wireless connections available.</p>
    }
    else
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Source</th>
                    <th>Destination</th>
                    <th>Distance</th>
                    <th>Power Cost</th>
                    <th>Active</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var connection in connections)
                {
                    <tr>
                        <td>@connection.SourceSensorId</td>
                        <td>@connection.DestinationSensorId</td>
                        <td>@connection.Distance</td>
                        <td>@connection.PowerCost</td>
                        <td>@connection.IsActive</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    @if (nodes.Count >= 2)
    {
        <h5 class="mt-3">Add Wireless Connection</h5>

        <div class="card p-3 mb-3">
            <label class="form-label">Source Sensor</label>
            <select class="form-select mb-2" @bind="newConnectionSourceId">
                @foreach (var node in nodes)
                {
                    <option value="@node.SensorId">
                        @node.DeviceName (@node.SensorId)
                    </option>
                }
            </select>

            <label class="form-label">Destination Sensor</label>
            <select class="form-select mb-2" @bind="newConnectionDestinationId">
                @foreach (var node in nodes)
                {
                    <option value="@node.SensorId">
                        @node.DeviceName (@node.SensorId)
                    </option>
                }
            </select>

            <label class="form-label">Distance</label>
            <input type="number" class="form-control mb-2"
                   min="0" step="0.1" @bind="newConnectionDistance" />

            <label class="form-label">Power Cost</label>
            <input type="number" class="form-control mb-2"
                   min="0" step="0.1" @bind="newConnectionPowerCost" />

            <button class="btn btn-success mt-2"
                    @onclick="AddWirelessConnectionAsync">
                Add Wireless Connection
            </button>
        </div>
    }

    <hr />
    <hr />

    <h3>🧭 Sensor Route to Central Gateway</h3>

    <button class="btn btn-primary mb-3"
            @onclick="FindRouteAsync"
            disabled="@(string.IsNullOrWhiteSpace(selectedSensorId))">
        Find Route to Central Gateway
    </button>

    @if (sensorRoute.Count > 0)
    {
        <div class="alert alert-success">
            <strong>Route found:</strong>
            @string.Join(" → ", sensorRoute.Select(id =>
                nodes.FirstOrDefault(n => n.SensorId == id)?.DeviceName ?? id))
        </div>
    }

    <h3>🔍 Network Search Algorithms</h3>

    <label>Select starting sensor</label>

    <select class="form-select mb-3" @bind="selectedSensorId">
        @foreach (var node in nodes)
        {
            <option value="@node.SensorId">
                @node.DeviceName (@node.SensorId)
            </option>
        }
    </select>
    <button class="btn btn-success mb-3"
            @onclick="SetGatewayAsync"
            disabled="@(string.IsNullOrWhiteSpace(selectedSensorId))">
        Set Selected Sensor as Central Gateway
    </button>

    <button class="btn btn-primary me-2"
            @onclick="RunBFSAsync">
        Breadth-First Search
    </button>

    <button class="btn btn-secondary me-2"
            @onclick="RunDFSAsync">
        Depth-First Search
    </button>

    <button class="btn btn-warning"
            @onclick="FindDisconnectedAsync">
        Find Disconnected Sensors
    </button>

    @if (searchResults.Count > 0)
    {
        <h5 class="mt-3">Search Results</h5>
        <ol>
            @foreach (var result in searchResults)
            {
                <li>@result</li>
            }
        </ol>
    }

    @if (hasCheckedDisconnected)
    {
        @if (disconnectedNodes.Count > 0)
        {
            <h5 class="mt-3">Disconnected Sensors</h5>

            @foreach (var node in disconnectedNodes)
            {
                <p>@node.DeviceName – @node.SensorId</p>
            }
        }
        else
        {
            <div class="alert alert-success mt-3">
                No disconnected sensors found. All sensors are connected!
            </div>
        }
    }

    <hr />

    <h3>⚡ Minimum Spanning Tree</h3>

    <button class="btn btn-success"
            @onclick="CalculateMSTAsync">
        Calculate Minimum Spanning Tree
    </button>

    @if (mst != null)
    {
        <h5 class="mt-3">Selected Connections</h5>

        @foreach (var connection in mst.Connections)
        {
            <p>
                @connection.SourceSensorId →
                @connection.DestinationSensorId
                | Power: @connection.PowerCost
            </p>
        }

        <h4>Total Power Cost: @mst.TotalPowerCost</h4>
    }

    <hr />

    <h3>📊 Historical Telemetry</h3>
    <div class="card p-3 mb-3">
        <h5>Search Historical Readings</h5>

        <label class="form-label">Select Sensor</label>
        <select class="form-select mb-2" @bind="historySensorId">
            @foreach (var node in nodes)
            {
                <option value="@node.SensorId">
                    @node.DeviceName (@node.SensorId)
                </option>
            }
        </select>

        <label class="form-label">Start Date and Time</label>
        <input type="datetime-local"
               class="form-control mb-2"
               @bind="historyStart" />

        <label class="form-label">End Date and Time</label>
        <input type="datetime-local"
               class="form-control mb-2"
               @bind="historyEnd" />

        <button class="btn btn-primary mt-2"
                @onclick="SearchHistoricalReadingsAsync">
            Search Historical Readings
        </button>

        <button class="btn btn-secondary mt-2"
                @onclick="RefreshAsync">
            Show All Readings
        </button>
    </div>

    @if (readings.Count == 0)
    {
        <p>No historical readings available.</p>
    }
    else
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Sensor</th>
                    <th>Metric</th>
                    <th>Value</th>
                    <th>Timestamp</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var reading in readings)
                {
                    <tr>
                        <td>@reading.SensorId</td>
                        <td>@reading.MetricName</td>
                        <td>@reading.Value</td>
                        <td>@reading.Timestamp.ToLocalTime()</td>
                    </tr>
                }
            </tbody>
        </table>
    }

</div>

@code {
    private List<NetworkNodeModel> nodes = new();
    private List<NetworkConnectionModel> connections = new();
    private List<HistoricalTelemetryRecord> readings = new();

    private List<string> searchResults = new();
    private List<NetworkNodeModel> disconnectedNodes = new();
    private bool hasCheckedDisconnected = false;
    private List<string> sensorRoute = new();

    private string selectedSensorId = "";
    private string message = "";
    private string historySensorId = "";

    private DateTime historyStart = DateTime.Now.AddDays(-1);

    private DateTime historyEnd = DateTime.Now;
    private string newConnectionSourceId = "";
    private string newConnectionDestinationId = "";

    private double newConnectionDistance = 1;
    private double newConnectionPowerCost = 1;

    private MstResponse? mst;

    private class MstResponse
    {
        public List<NetworkConnectionModel> Connections { get; set; } = new();
        public double TotalPowerCost { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        try
        {
            nodes = await Http.GetFromJsonAsync<List<NetworkNodeModel>>(
                "api/NetworkTopology/nodes") ?? new();

            connections = await Http.GetFromJsonAsync<List<NetworkConnectionModel>>(
                "api/NetworkTopology/connections") ?? new();

            readings = await Http.GetFromJsonAsync<List<HistoricalTelemetryRecord>>(
                "api/NetworkTopology/readings") ?? new();

            if (string.IsNullOrEmpty(selectedSensorId) && nodes.Count > 0)
            {
                selectedSensorId = nodes[0].SensorId;
            }
            if (string.IsNullOrEmpty(historySensorId) && nodes.Count > 0)
            {
                historySensorId = nodes[0].SensorId;
            }

            message = "Network dashboard refreshed successfully.";
        }
        catch (Exception ex)
        {
            message = $"Could not load network data: {ex.Message}";
        }
    }

    private async Task RunBFSAsync()
    {
        await RunSearchAsync("bfs");
    }

    private async Task RunDFSAsync()
    {
        await RunSearchAsync("dfs");
    }

    private async Task FindRouteAsync()
    {
        if (string.IsNullOrWhiteSpace(selectedSensorId))
        {
            message = "Please select a sensor first.";
            return;
        }

        try
        {
            sensorRoute = await Http.GetFromJsonAsync<List<string>>(
                $"api/NetworkTopology/route/{Uri.EscapeDataString(selectedSensorId)}")
                ?? new();

            if (sensorRoute.Count == 0)
                message = "No available route to the central gateway.";
            else
                message = "Route to central gateway found.";
        }
        catch (Exception ex)
        {
            sensorRoute = new();
            message = $"Route search failed: {ex.Message}";
        }
    }
    private async Task RunSearchAsync(string algorithm)
    {
        if (string.IsNullOrWhiteSpace(selectedSensorId))
        {
            message = "Select a starting sensor first.";
            return;
        }

        try
        {
            searchResults = await Http.GetFromJsonAsync<List<string>>(
                $"api/NetworkTopology/{algorithm}/{Uri.EscapeDataString(selectedSensorId)}")
                ?? new();

            message = $"{algorithm.ToUpper()} search completed.";
        }
        catch (Exception ex)
        {
            message = $"Search failed: {ex.Message}";
        }
    }

    private async Task FindDisconnectedAsync()
    {
        if (string.IsNullOrWhiteSpace(selectedSensorId))
        {
            message = "Select a gateway sensor first.";
            return;
        }

        try
        {
            disconnectedNodes =
                await Http.GetFromJsonAsync<List<NetworkNodeModel>>(
                    $"api/NetworkTopology/disconnected/{Uri.EscapeDataString(selectedSensorId)}")
                ?? new();

            message = "Disconnected sensor check completed.";
            hasCheckedDisconnected = true;
        }
        catch (Exception ex)
        {
            message = $"Connectivity check failed: {ex.Message}";
        }
    }

    private async Task CalculateMSTAsync()
    {
        try
        {
            mst = await Http.GetFromJsonAsync<MstResponse>(
                "api/NetworkTopology/mst");

            message = "Minimum Spanning Tree calculated.";
        }
        catch (Exception ex)
        {
            message = $"MST calculation failed: {ex.Message}";
        }
    }
    private async Task SetGatewayAsync()
    {
        if (string.IsNullOrWhiteSpace(selectedSensorId))
        {
            message = "Please select a sensor first.";
            return;
        }

        try
        {
            var response = await Http.PutAsync(
                $"api/NetworkTopology/gateway/{Uri.EscapeDataString(selectedSensorId)}",
                null);

            if (response.IsSuccessStatusCode)
            {
                await RefreshAsync();
                message = "Central gateway assigned successfully.";
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                message = $"Gateway assignment failed: {error}";
            }
        }
        catch (Exception ex)
        {
            message = $"Gateway assignment failed: {ex.Message}";
        }
    }
    private async Task AddWirelessConnectionAsync()
    {
        if (string.IsNullOrWhiteSpace(newConnectionSourceId) ||
            string.IsNullOrWhiteSpace(newConnectionDestinationId))
        {
            message = "Please select both sensors.";
            return;
        }

        if (newConnectionSourceId == newConnectionDestinationId)
        {
            message = "A sensor cannot connect to itself.";
            return;
        }

        if (newConnectionDistance < 0 || newConnectionPowerCost < 0)
        {
            message = "Distance and power cost cannot be negative.";
            return;
        }

        var connection = new NetworkConnectionModel
        {
            SourceSensorId = newConnectionSourceId,
            DestinationSensorId = newConnectionDestinationId,
            Distance = newConnectionDistance,
            PowerCost = newConnectionPowerCost,
            IsActive = true
        };

        try
        {
            var response = await Http.PostAsJsonAsync(
                "api/NetworkTopology/connections", connection);

            if (response.IsSuccessStatusCode)
            {
                await RefreshAsync();

                message = "Wireless connection added successfully.";
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                message = $"Connection failed: {error}";
            }
        }
        catch (Exception ex)
        {
            message = $"Connection failed: {ex.Message}";
        }
    }
    private async Task SearchHistoricalReadingsAsync()
    {
        if (string.IsNullOrWhiteSpace(historySensorId))
        {
            message = "Please select a sensor.";
            return;
        }

        if (historyStart > historyEnd)
        {
            message = "Start date must be before the end date.";
            return;
        }

        try
        {
            string start = Uri.EscapeDataString(historyStart.ToString("o"));
            string end = Uri.EscapeDataString(historyEnd.ToString("o"));

            readings = await Http.GetFromJsonAsync<List<HistoricalTelemetryRecord>>(
                $"api/NetworkTopology/readings/{Uri.EscapeDataString(historySensorId)}?start={start}&end={end}")
                ?? new();

            message = $"Historical search completed. {readings.Count} reading(s) found.";
        }
        catch (Exception ex)
        {
            message = $"Historical search failed: {ex.Message}";
        }
    }
    // Calculates the position of each sensor in the network diagram.
    private double GetNodeX(string sensorId)
    {
        int index = nodes.FindIndex(n => n.SensorId == sensorId);

        if (index < 0 || nodes.Count == 0)
            return 350;

        double angle = -Math.PI / 2 +
                       (2 * Math.PI * index / nodes.Count);

        return 350 + 150 * Math.Cos(angle);
    }

    private double GetNodeY(string sensorId)
    {
        int index = nodes.FindIndex(n => n.SensorId == sensorId);

        if (index < 0 || nodes.Count == 0)
            return 210;

        double angle = -Math.PI / 2 +
                       (2 * Math.PI * index / nodes.Count);

        return 210 + 150 * Math.Sin(angle);
    }

    // Displays the power cost near each connection.
    private double GetConnectionLabelX(NetworkConnectionModel connection)
    {
        return (GetNodeX(connection.SourceSensorId) +
                GetNodeX(connection.DestinationSensorId)) / 2;
    }

    private double GetConnectionLabelY(NetworkConnectionModel connection)
    {
        return (GetNodeY(connection.SourceSensorId) +
                GetNodeY(connection.DestinationSensorId)) / 2 - 8;
    }
}
